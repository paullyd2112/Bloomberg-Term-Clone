{
  "mcpServers": {
    "railway": {
      "command": "railway",
      "args": ["mcp"],
      "env": {
        "RAILWAY_API_TOKEN": "${RAILWAY_API_TOKEN}"
      }
    },
    "dreamlit": {
      "type": "http",
      "url": "https://mcp.dreamlit.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${DREAMLIT_API_TOKEN}"
      }
    }
  }
}
