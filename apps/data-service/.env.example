# ─── Supabase (required) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (required) ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Market Data APIs (optional — needed for ingestion) ───────
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
FMP_API_KEY=
COINGECKO_API_KEY=

# ─── Prediction Markets ──────────────────────────────────────
# Kalshi is disabled — Polymarket (free, no auth) is the active source
NEWS_API_KEY=

# ─── Email (required for newsletter/briefings) ───────────────
RESEND_API_KEY=

# ─── Web Push (VAPID — browser notifications) ─────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Uptime monitoring ────────────────────────────────────────
ALERT_EMAIL=you@example.com

# ─── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
APP_ENV=development

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_SCHEDULER=false
PORT=8080
