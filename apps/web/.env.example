# ─── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (required for Pleby chat) ─────────────────────────────
ANTHROPIC_API_KEY=

# ─── Email ────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Beehiiv (optional — newsletter subscriber management) ────
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ─── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com

# ─── Rate limiting (optional — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring (optional) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Web Push (VAPID public key — must match data service) ────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Market data (optional — for ticker page price quotes) ────
ALPACA_API_KEY=
ALPACA_API_SECRET=
FMP_API_KEY=
FINNHUB_API_KEY=

# ─── Data service URL (required) ──────────────────────────────
DATA_SERVICE_URL=http://localhost:8080

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
